	cd /home/houzh/cdroidMaster && $(MAKE) $(MAKESILENT) -f tests/gui/CMakeFiles/gui_test.dir/build.make tests/gui/CMakeFiles/gui_test.dir/widget_tests.cc.s
.PHONY : widget_tests.cc.s

