<?xml version="1.0" encoding="utf-8"?>
<!-- Nav graph for NavHostFragment tests. Mirrors navdemo's route-based form:
     app:startDestination="<route>" + app:route on each <fragment> (the form CDROID's
     NavInflater resolves). app: namespace, not android: — aapt2 link rejects
     android:startDestination since the framework has no such attr (NavInflater
     reads by local name so the runtime is agnostic, but link is strict). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res/cdroid.widgetex"
            android:id="@+id/nav_host_test"
            app:startDestination="start_fragment">

    <fragment android:id="@+id/start_fragment" android:name="NavTestFragment" app:route="start_fragment" />
    <fragment android:id="@+id/second_fragment" android:name="NavTestFragment" app:route="second_fragment" />

</navigation>
