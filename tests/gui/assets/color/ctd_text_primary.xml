<?xml version="1.0" encoding="utf-8"?>
<!-- Light-theme primary text color selector (primary_text_material pattern):
     enabled #de000000, disabled #3d000000. Referenced by ctdThemeLight's
     android:textColorPrimary override. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#3D000000"/>
    <item android:color="#DE000000"/>
</selector>
