<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navigation graph attrs (androidx.navigation). Declared so aapt2 link
         accepts res-auto navigation XML in this test pak. NavInflater reads
         these by local name via AttributeSet at runtime, so attr IDs are
         irrelevant (no styleable IDS[] to align with, unlike widgetEx attrs).
         Mirrors the per-app attrs.xml in apps/navdemo & apps/printerdemo;
         adds argType/nullable/launchSingleTop used by the nav_args/simple tests. -->
    <attr name="startDestination" format="string" />
    <attr name="route" format="string" />
    <attr name="destination" format="reference" />
    <attr name="argType" format="string" />
    <attr name="nullable" format="boolean" />
    <attr name="launchSingleTop" format="boolean" />
    <attr name="popUpTo" format="string" />
    <attr name="popUpToInclusive" format="boolean" />
</resources>
