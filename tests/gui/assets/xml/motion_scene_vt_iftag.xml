<?xml version="1.0" encoding="utf-8"?>
<!-- ViewTransitionIfTagSetGates: the ViewTransition fires only while its target carries the
     ifTagSet tag (the tag key is the resource id). -->
<MotionScene xmlns:app="http://schemas.android.com/apk/res/cdroid.widgetex"
             xmlns:android="http://schemas.android.com/apk/res/android">
    <Transition app:constraintSetStart="@+id/ift_start" app:constraintSetEnd="@+id/ift_end" />
    <ConstraintSet android:id="@+id/ift_start">
        <Constraint android:id="@+id/ift_target" android:layout_width="100px" android:layout_height="50px"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </ConstraintSet>
    <ConstraintSet android:id="@+id/ift_end">
        <Constraint android:id="@+id/ift_target" android:layout_width="100px" android:layout_height="50px"
                    app:layout_constraintRight_toRightOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </ConstraintSet>
    <ViewTransition android:id="@+id/vt_gate" app:motionTarget="@+id/ift_target"
                    app:onStateTransition="actionDown" app:duration="400"
                    app:viewTransitionMode="noState" app:ifTagSet="@+id/ift_tag_key">
        <KeyFrameSet>
            <KeyAttribute app:motionTarget="@+id/ift_target" app:framePosition="50"
                          android:alpha="0" />
        </KeyFrameSet>
    </ViewTransition>
</MotionScene>
