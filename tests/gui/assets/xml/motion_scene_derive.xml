<?xml version="1.0" encoding="utf-8"?>
<!-- MotionSceneDeriveConstraints: the derived set inherits the base set's constraints
     (same-id entries override — derived wins); the base may be defined after the derived. -->
<MotionScene xmlns:app="http://schemas.android.com/apk/res/cdroid.widgetex"
             xmlns:android="http://schemas.android.com/apk/res/android">
    <Transition app:constraintSetStart="@+id/dc_derived" app:constraintSetEnd="@+id/dc_base" />
    <ConstraintSet android:id="@+id/dc_derived" app:deriveConstraintsFrom="@+id/dc_base">
        <Constraint android:id="@+id/dc_one" android:layout_width="200px" android:layout_height="50px" />
        <Constraint android:id="@+id/dc_two" android:layout_width="80px" android:layout_height="40px" />
    </ConstraintSet>
    <ConstraintSet android:id="@+id/dc_base">
        <Constraint android:id="@+id/dc_one" android:layout_width="100px" android:layout_height="50px" />
        <Constraint android:id="@+id/dc_three" android:layout_width="60px" android:layout_height="30px" />
    </ConstraintSet>
</MotionScene>
