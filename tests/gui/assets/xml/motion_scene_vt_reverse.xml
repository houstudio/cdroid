<?xml version="1.0" encoding="utf-8"?>
<!-- ViewTransitionNoStateDownUpReverses: a main <Transition> (so MotionLayout has a
     current state) plus the actionDownUp ViewTransition whose held animation an
     ACTION_UP reverses over upDuration. -->
<MotionScene xmlns:app="http://schemas.android.com/apk/res/cdroid.widgetex"
             xmlns:android="http://schemas.android.com/apk/res/android">
    <Transition app:constraintSetStart="@+id/rv_start" app:constraintSetEnd="@+id/rv_end" />
    <ConstraintSet android:id="@+id/rv_start">
        <Constraint android:id="@+id/rv_target" android:layout_width="100px" android:layout_height="50px"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </ConstraintSet>
    <ConstraintSet android:id="@+id/rv_end">
        <Constraint android:id="@+id/rv_target" android:layout_width="100px" android:layout_height="50px"
                    app:layout_constraintRight_toRightOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </ConstraintSet>
    <ViewTransition android:id="@+id/vt_rev" app:motionTarget="@+id/rv_target"
                    app:onStateTransition="actionDownUp" app:duration="400" app:upDuration="200"
                    app:viewTransitionMode="noState">
        <KeyFrameSet>
            <KeyAttribute app:motionTarget="@+id/rv_target" app:framePosition="50"
                          android:scaleX="1.5" android:scaleY="1.5" />
        </KeyFrameSet>
    </ViewTransition>
</MotionScene>
