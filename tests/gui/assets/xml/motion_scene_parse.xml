<?xml version="1.0" encoding="utf-8"?>
<!-- MotionSceneXmlParse: one Transition referencing two inline ConstraintSets, with an
     OnClick, an OnSwipe and a KeyFrameSet child. The set refs resolve to the @+id
     resources defined by the inline <ConstraintSet android:id> entries. -->
<MotionScene xmlns:app="http://schemas.android.com/apk/res/cdroid.widgetex"
             xmlns:android="http://schemas.android.com/apk/res/android"
             app:defaultDuration="300">
    <Transition app:constraintSetStart="@+id/ms_start" app:constraintSetEnd="@+id/ms_end"
                app:duration="500">
        <OnClick app:targetId="@+id/ms_target" app:clickAction="toggle" />
        <OnSwipe app:dragDirection="dragRight" app:dragScale="2.0"
                 app:onTouchUp="autoCompleteToStart" />
        <KeyFrameSet>
            <KeyAttribute app:motionTarget="@+id/ms_target" app:framePosition="50"
                          android:alpha="0" />
        </KeyFrameSet>
    </Transition>
    <ConstraintSet android:id="@+id/ms_start">
        <Constraint android:id="@+id/ms_target" android:layout_width="100px" android:layout_height="50px"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </ConstraintSet>
    <ConstraintSet android:id="@+id/ms_end">
        <Constraint android:id="@+id/ms_target" android:layout_width="100px" android:layout_height="50px"
                    app:layout_constraintRight_toRightOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </ConstraintSet>
</MotionScene>
