<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-theme global-nav slab: near-black ink (merges with the dark canvas)
     with a tile-2 hairline seam along the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2A2C"/>
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D1D1F"/>
        </shape>
    </item>
</layer-list>
