<?xml version="1.0" encoding="utf-8"?>
<!-- Scan CTA: same button-primary grammar — one blue for every commit
     action; the green resource name is historical. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0071E3"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0066CC"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
</selector>
