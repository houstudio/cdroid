<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/cdroid.widgetex"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">
    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:minHeight="42dp"
        android:gravity="center_vertical"
        android:buttonGravity="center_vertical"
        android:titleTextAppearance="@style/ToolbarTitle"
        android:background="?android:attr/colorPrimary"
        android:titleTextColor="#FFFFFFFF"
        android:title="@string/app_name" />
    <FrameLayout
        android:id="@+id/nav_host_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?android:attr/colorBackground" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceVariant" />
    <BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/navBackground"
        app:itemBackground="@drawable/nav_item_background"
        app:itemTextColor="@color/nav_item_text"
        app:itemIconTint="@color/nav_item_icon"
        app:itemIconGravity="start"
        app:itemGravity="center"
        app:iconLabelHorizontalSpacing="5dp"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
