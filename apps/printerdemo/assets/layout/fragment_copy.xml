<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="?attr/cardBackground" android:padding="16dp">
                    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/btn_card_accent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="数" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                    </FrameLayout>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/copy_copies" android:textSize="15sp" android:textColor="?android:attr/textColorPrimary"/>
                    <Button android:id="@+id/btn_minus" android:layout_width="44dp" android:layout_height="44dp"
                        android:text="－" android:textSize="18sp"/>
                    <TextView android:id="@+id/tv_copies" android:layout_width="48dp" android:layout_height="wrap_content"
                        android:gravity="center" android:text="1" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF1565C0"/>
                    <Button android:id="@+id/btn_plus" android:layout_width="44dp" android:layout_height="44dp"
                        android:text="＋" android:textSize="18sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical"
                    android:background="?attr/cardBackground" android:padding="16dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/btn_card_purple">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="色" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="@string/label_color" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <RadioGroup android:id="@+id/rg_color"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <RadioButton android:id="@+id/rb_bw" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="24dp" android:text="@string/mode_mono" android:checked="true"/>
                        <RadioButton android:id="@+id/rb_color" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/mode_color"/>
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical"
                    android:background="?attr/cardBackground" android:padding="16dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/btn_card_amber">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="纸" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="@string/label_paper" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <RadioGroup android:id="@+id/rg_paper"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp" android:text="A4" android:checked="true"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp" android:text="Letter"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="A3"/>
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical"
                    android:background="?attr/cardBackground" android:padding="16dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/btn_card_green">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="质" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="10dp" android:text="@string/label_quality" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                    <RadioGroup android:id="@+id/rg_quality"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp" android:text="@string/quality_draft"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginEnd="20dp" android:text="@string/quality_standard" android:checked="true"/>
                        <RadioButton android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="高"/>
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="vertical"
                    android:background="?attr/cardBackground" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/btn_card_accent">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="缩" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/label_scale" android:textSize="15sp" android:textColor="?android:attr/textColorPrimary"/>
                        <TextView android:id="@+id/tv_zoom" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="100%" android:textSize="15sp" android:textStyle="bold" android:textColor="#FF1565C0"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/seek_zoom"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:max="200" android:progress="100"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button android:id="@+id/btn_start"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_margin="20dp" android:background="@drawable/btn_primary"
            android:text="@string/copy_start" android:textColor="#FFFFFFFF" android:textSize="16sp"/>
    </LinearLayout>

    <!-- Printing overlay: spinner + status narrative. clickable=true blocks interaction while "printing". -->
    <FrameLayout android:id="@+id/print_overlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#B3000000" android:clickable="true" android:visibility="gone">
        <LinearLayout
            android:layout_width="260dp" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal"
            android:background="?attr/cardBackground" android:padding="28dp">
            <LinearLayout android:id="@+id/print_track"
                android:layout_width="200dp" android:layout_height="8dp"
                android:orientation="horizontal" android:weightSum="100"
                android:background="?attr/progressTrack">
                <View android:id="@+id/print_fill"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@drawable/btn_primary"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/copy_busy" android:textSize="16sp"
                android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
            <TextView android:id="@+id/print_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/loading" android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
