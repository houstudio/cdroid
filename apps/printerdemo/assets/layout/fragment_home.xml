<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp" android:paddingRight="16dp"
        android:paddingTop="14dp" android:paddingBottom="16dp">

        <!-- HERO: gradient banner, deco circles + printer glyph, status pill -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:background="@drawable/hero_bg">
            <View
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="-72dp"
                android:background="@drawable/circle_deco"/>
            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="52dp"
                android:layout_marginBottom="-34dp"
                android:background="@drawable/circle_deco"/>
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="36dp"
                android:alpha="0.55"
                android:src="@drawable/ic_printer_white" android:importantForAccessibility="no"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingLeft="24dp" android:paddingRight="24dp"
                android:paddingTop="16dp" android:paddingBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/home_title" android:textSize="25sp" android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="@string/home_tagline"
                                android:textSize="12sp" android:textColor="#B3FFFFFF"/>
                            <ImageView android:layout_width="15dp" android:layout_height="15dp"
                                android:src="@drawable/ic_wifi_white" android:importantForAccessibility="no"/>
                            <TextView android:id="@+id/network_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="6dp" android:text="Wi-Fi · CDROID-Net · 192.168.1.50"
                                android:textSize="12sp" android:textColor="#E6FFFFFF"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/pill_bg" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/status_dot"/>
                        <TextView android:id="@+id/status_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="7dp" android:text="@string/status_ready" android:textSize="12sp"
                            android:textStyle="bold" android:textColor="#FFFFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- INK: vertical cartridge bars (weights driven by PrinterViewModel) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="?attr/cardBackground"
            android:paddingLeft="16dp" android:paddingRight="16dp"
            android:paddingTop="14dp" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/label_ink" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ink_footnote" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center">
                <!-- K 85% -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <LinearLayout android:layout_width="30dp" android:layout_height="100dp" android:weightSum="100" android:orientation="vertical" android:background="?attr/progressTrack" android:padding="3dp">
                        <View android:id="@+id/ink_k_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="15"/>
                        <View android:id="@+id/ink_k_fill" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="85" android:background="?attr/inkBlackFill"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <TextView android:id="@+id/ink_k_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="85%" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- C 60% -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <LinearLayout android:layout_width="30dp" android:layout_height="100dp" android:weightSum="100" android:orientation="vertical" android:background="?attr/progressTrack" android:padding="3dp">
                        <View android:id="@+id/ink_c_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40"/>
                        <View android:id="@+id/ink_c_fill" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60" android:background="@drawable/ink_fill_c"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <TextView android:id="@+id/ink_c_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="60%" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- M 40% (low) -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <LinearLayout android:layout_width="30dp" android:layout_height="100dp" android:weightSum="100" android:orientation="vertical" android:background="?attr/progressTrack" android:padding="3dp">
                        <View android:id="@+id/ink_m_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60"/>
                        <View android:id="@+id/ink_m_fill" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40" android:background="@drawable/ink_fill_m"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <TextView android:id="@+id/ink_m_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="40%" android:textSize="11sp" android:textColor="#FF7A7A7A"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- Y 72% -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                    <LinearLayout android:layout_width="30dp" android:layout_height="100dp" android:weightSum="100" android:orientation="vertical" android:background="?attr/progressTrack" android:padding="3dp">
                        <View android:id="@+id/ink_y_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="28"/>
                        <View android:id="@+id/ink_y_fill" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="72" android:background="@drawable/ink_fill_y"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y" android:textSize="13sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <TextView android:id="@+id/ink_y_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="72%" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PAPER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/cardBackground"
            android:padding="14dp">
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/chip_blue">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_doc_green" android:importantForAccessibility="no"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:id="@+id/paper_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paper_tray" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                <TextView android:id="@+id/paper_sheets" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/paper_remaining" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
            <LinearLayout android:layout_width="120dp" android:layout_height="10dp" android:layout_marginStart="12dp" android:weightSum="100" android:orientation="horizontal" android:background="?attr/progressTrack" android:padding="2dp">
                <View android:id="@+id/paper_fill" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="80" android:background="@drawable/bar_fill_blue"/>
                <View android:id="@+id/paper_space" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="20"/>
            </LinearLayout>
            <TextView android:id="@+id/paper_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="80%" android:textSize="12sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
        </LinearLayout>

        <!-- STATISTICS: live job counters driven by PrinterViewModel (no hardcoded values). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/cardBackground"
            android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingLeft="10dp" android:paddingRight="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/stat_prints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF1D1D1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stat_total_print" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="30dp" android:background="?attr/colorSurfaceVariant"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/stat_scans" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF1D1D1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stat_total_scan" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="30dp" android:background="?attr/colorSurfaceVariant"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/stat_copies" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF1D1D1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stat_copies" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="30dp" android:background="?attr/colorSurfaceVariant"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/stat_maint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#FF1D1D1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/stat_maint" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FUNCTION grid: tonal-chip rows (icon + text on one line; entrance fade via transition framework) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:layout_marginBottom="8dp"
            android:text="@string/home_functions" android:textSize="16sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:id="@+id/card_copy"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="74dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/cardRipple"
                android:padding="14dp" android:visibility="invisible">
                <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/chip_blue">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                        android:src="@drawable/ic_copy_blue" android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="13dp" android:layout_marginEnd="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/action_copy" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/sub_copy" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="10dp" android:layout_height="0dp"/>
<LinearLayout android:id="@+id/card_scan"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="74dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/cardRipple"
                android:padding="14dp" android:visibility="invisible">
                <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/chip_green">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                        android:src="@drawable/ic_scan_green" android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="13dp" android:layout_marginEnd="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/action_scan" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/sub_scan" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
<LinearLayout android:id="@+id/card_maintain"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="74dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/cardRipple"
                android:padding="14dp" android:visibility="invisible">
                <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/chip_amber">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                        android:src="@drawable/ic_wrench_amber" android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="13dp" android:layout_marginEnd="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/action_maintain" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/sub_maintain" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
            </LinearLayout>
            <View android:layout_width="10dp" android:layout_height="0dp"/>
<LinearLayout android:id="@+id/card_settings"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="74dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/cardRipple"
                android:padding="14dp" android:visibility="invisible">
                <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/chip_purple">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                        android:src="@drawable/ic_gear_purple" android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="13dp" android:layout_marginEnd="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/action_settings" android:textSize="15sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/sub_settings" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>