<?xml version="1.0" encoding="utf-8"?>
<!-- ASLD transition drawable (unmarked -> marked): filled star spins in and pops. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/star_filled">
    <target
        android:name="star"
        android:animation="@anim/star_spin" />
    <target
        android:name="star"
        android:animation="@anim/star_pop_in" />
</animated-vector>
