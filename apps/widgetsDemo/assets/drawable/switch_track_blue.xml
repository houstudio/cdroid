<?xml version="1.0" encoding="utf-8"?>
<!-- Thick switch track: 24dp capsule so the 20dp thumb sits inside. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2E7CF6"/>
            <corners android:radius="12dp"/>
            <size android:width="52dp" android:height="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF243244"/>
            <corners android:radius="12dp"/>
            <size android:width="52dp" android:height="24dp"/>
        </shape>
    </item>
</selector>
