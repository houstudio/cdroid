<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: outlined, fills faintly on press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#332E5FE0" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="@dimen/btn_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141B2A" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="@dimen/btn_corner" />
        </shape>
    </item>
</selector>
