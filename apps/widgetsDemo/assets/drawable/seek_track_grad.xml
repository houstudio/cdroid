<?xml version="1.0" encoding="utf-8"?>
<!-- SeekBar track: gradient capsule (blue -> violet). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF2E5FE0" android:endColor="#FF7C5CFF" android:angle="0"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="#FF4EA1FF" android:endColor="#FF9B5CFF" android:angle="0"/>
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
