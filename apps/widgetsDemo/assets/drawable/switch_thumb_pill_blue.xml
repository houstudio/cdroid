<?xml version="1.0" encoding="utf-8"?>
<!-- Pill thumb for the showText switch (AOSP material look: the ON/OFF text
     renders ON the thumb, so the thumb is a wide accent capsule, not a disc). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF2E7CF6"/>
    <corners android:radius="12dp"/>
    <size android:width="48dp" android:height="24dp"/>
</shape>
