<?xml version="1.0" encoding="utf-8"?>
<!--
  MotionScene for the widgetsDemo MotionLayout section. Drives the three boxes purely from XML:
  tap any box to toggle the 800ms ease-in-out transition. Box 1 arcs, Box 2 fades, Box 3 rotates.
  No code wires this — MotionLayout reads it via app:layoutDescription="@xml/scene_constraint".
-->
<MotionScene xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    app:defaultDuration="800">

    <Transition
        app:constraintSetStart="@+id/start"
        app:constraintSetEnd="@+id/end"
        app:duration="800"
        app:motionInterpolator="standard"
        app:pathMotionArc="startVertical">

        <OnClick app:targetId="@id/ml_box1" app:clickAction="toggle" />
        <OnClick app:targetId="@id/ml_box2" app:clickAction="toggle" />
        <OnClick app:targetId="@id/ml_box3" app:clickAction="toggle" />

        <!-- Drag right to drive the transition manually; release snaps to the nearest end. The drag
             range tracks box1's start->end travel (touchAnchorId), and MotionLayout claims the
             gesture (requestDisallowInterceptTouchEvent) so the outer ViewPager2 can't steal it.
             A tap (no drag) still toggles via the OnClick handlers above. -->
        <OnSwipe app:dragDirection="dragRight" app:touchAnchorId="@id/ml_box1" app:dragScale="1.0"
                 app:onTouchUp="autoComplete" app:autoCompleteMode="spring"
                 app:springStiffness="300" app:springDamping="6" app:springMass="1"
                 app:springStopThreshold="0.01" app:springBoundary="bounceBoth" />

        <KeyFrameSet>
            <!-- Box 1: spline arc — bows above the diagonal at the midpoint (KeyPosition) -->
            <KeyPosition app:motionTarget="@id/ml_box1" app:framePosition="50"
                         app:percentX="0.5" app:percentY="0.2" app:keyPositionType="parentRelative" />
            <!-- Box 2: pure elliptical arc via the Transition pathMotionArc (no keyframe — fully visible) -->
            <!-- Box 3: rotate — +90° at 25%, -90° at 75% -->
            <KeyAttribute app:motionTarget="@id/ml_box3" app:framePosition="25" android:rotation="90" />
            <KeyAttribute app:motionTarget="@id/ml_box3" app:framePosition="75" android:rotation="-90" />
        </KeyFrameSet>
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@id/ml_box1" android:layout_width="100dp" android:layout_height="70dp"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <Constraint android:id="@id/ml_box2" android:layout_width="100dp" android:layout_height="70dp"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <Constraint android:id="@id/ml_box3" android:layout_width="100dp" android:layout_height="70dp"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/ml_box1" android:layout_width="100dp" android:layout_height="70dp"
                    app:layout_constraintRight_toRightOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <Constraint android:id="@id/ml_box2" android:layout_width="100dp" android:layout_height="70dp"
                    app:layout_constraintRight_toRightOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <Constraint android:id="@id/ml_box3" android:layout_width="100dp" android:layout_height="70dp"
                    app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
    </ConstraintSet>

    <ViewTransition android:id="@+id/vt_pop" app:motionTarget="@id/ml_box2"
                    app:onStateTransition="actionDown" app:duration="300"
                    app:viewTransitionMode="noState" app:motionInterpolator="standard">
        <KeyFrameSet>
            <KeyAttribute app:motionTarget="@id/ml_box2" app:framePosition="50"
                          android:scaleX="1.3" android:scaleY="1.3" />
        </KeyFrameSet>
    </ViewTransition>
    <ViewTransition android:id="@+id/vt_grow" app:motionTarget="@id/ml_box3"
                    app:onStateTransition="actionDown" app:duration="400"
                    app:viewTransitionMode="currentState" app:motionInterpolator="accelerate">
        <ConstraintOverride app:motionTarget="@id/ml_box3" android:scaleX="1.4" android:scaleY="1.4" />
    </ViewTransition>

</MotionScene>
