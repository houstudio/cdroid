<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- Page header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buttons &amp; Toggles"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="Button, ripple, switch, checkbox, radio and rating widgets"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_size" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_buttons"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/row_gap">
                <Button
                    android:id="@+id/btn_default"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="#FFFFFFFF"
                    android:text="Primary" />
                <Button
                    android:id="@+id/btn_outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/row_gap"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="@color/accent"
                    android:text="Outline" />
                <Button
                    android:id="@+id/btn_ripple"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginStart="@dimen/row_gap"
                    android:background="@drawable/ripple_demo"
                    android:textColor="#FFFFFFFF"
                    android:text="Ripple" />
            </LinearLayout>

            <TextView
                android:id="@+id/result_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:textColor="@color/accent"
                android:textSize="@dimen/body_size"
                android:text="@string/tap_hint" />
        </LinearLayout>

        <!-- Toggles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">

            <Switch
                android:id="@+id/switch1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:text="Switch" />
            <ToggleButton
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:textOn="Toggle ON"
                android:textOff="Toggle OFF" />
            <CheckBox
                android:id="@+id/checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:textColor="@color/text_primary"
                android:text="CheckBox" />
        </LinearLayout>

        <!-- Choice & Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sec_choice"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />

            <RadioGroup
                android:id="@+id/radiogroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/radio_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:text="Option A" />
                <RadioButton
                    android:id="@+id/radio_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:text="Option B" />
            </RadioGroup>

            <RatingBar
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/row_gap"
                android:numStars="5"
                android:rating="3" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
