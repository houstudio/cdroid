<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pickers &amp; Feedback"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="NumberPicker, AChart line chart, QR code, dialogs and toasts"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_size" />

        <!-- NumberPicker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NumberPicker"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/row_gap">
                <NumberPicker
                    android:id="@+id/np_temp"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />
                <NumberPicker
                    android:id="@+id/np_speed"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="12dp">
                    <TextView
                        android:id="@+id/np_value_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="22°C · fan 2"
                        android:textColor="@color/accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Drag the wheels to pick a temperature and a fan speed."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- AChart line chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AChart — live line chart"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <FrameLayout
                android:id="@+id/chart_container"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/row_gap"
                android:background="@drawable/tile_blue" />
        </LinearLayout>

        <!-- QR code -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR code"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/row_gap">
                <QRCodeView
                    android:id="@+id/qr"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="#FFFFFFFF"
                    android:padding="6dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="14dp"
                    android:text="Scan to open the cdroid documentation site. QRCodeView renders any text into a scannable 2D code."
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_size" />
            </LinearLayout>
        </LinearLayout>

        <!-- Feedback buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feedback"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/row_gap">
                <Button
                    android:id="@+id/btn_toast"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="#FFFFFFFF"
                    android:text="Toast" />
                <Button
                    android:id="@+id/btn_dialog"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@animator/press_scale"
                    android:textColor="@color/accent"
                    android:text="Dialog" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
