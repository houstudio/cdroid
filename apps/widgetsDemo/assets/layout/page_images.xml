<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images &amp; Drawables"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_gap"
            android:text="ImageView scale types, gradient drawables and an animated vector"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_size" />

        <!-- ScaleType comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ScaleType"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/row_gap">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="6dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/tile_blue"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/demo_photo" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="fitCenter"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="6dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/tile_violet"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/demo_photo" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="centerCrop"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/tile_teal"
                        android:scaleType="fitXY"
                        android:src="@mipmap/demo_photo" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="fitXY"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Gradient drawable gallery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gradient drawables"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/row_gap">
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/tile_blue" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/tile_violet" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/tile_teal" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/tile_amber" />
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/circle_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Animated vector drawable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AnimatedVectorDrawable — tap to animate"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/section_size" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/row_gap">
                <ImageView
                    android:id="@+id/avd_img"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="fitCenter"
                    android:clickable="true" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="Vector paths morph between checked/unchecked states with a smooth animation."
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_size" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
