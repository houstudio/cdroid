<?xml version="1.0" encoding="utf-8"?>
<!-- ApiDemos-style shell: a fixed header (title + locale switch) above the
     fragment container the category browser and every demo are transacted
     into (FragmentManager replace + back stack). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/demo_header_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:text="@string/app_title" />

        <Button
            android:id="@+id/btn_locale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:background="@null"
            android:text="EN" />
    </LinearLayout>

    <!-- DemoListFragment and every demo Fragment live here. -->
    <FrameLayout
        android:id="@+id/demo_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
