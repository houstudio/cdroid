<?xml version="1.0" encoding="utf-8"?>
<!-- Port of AOSP 12 Settings res/xml/sound_settings.xml fragments. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="sound_settings"
    android:title="Sound &amp; vibration">

    <PreferenceCategory android:title="Media &amp; ring volume">

        <Preference android:key="volume_media" android:title="Media volume" android:selectable="false" />
        <Preference android:key="volume_ring" android:title="Ring &amp; notification volume" android:selectable="false" />
        <Preference android:key="volume_call" android:title="Call volume" android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Do Not Disturb">

        <Preference android:widgetLayout="@layout/prefdemo_chevron" android:key="dnd_mode" android:title="Do Not Disturb" android:summary="Off" />

        <SwitchPreference
            android:key="dnd_schedules"
            android:title="Schedules"
            android:summary="Turn Do Not Disturb on or off automatically"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Ringtones &amp; haptics">

        <ListPreference
            android:key="ringtone"
            android:title="Phone ringtone"
            android:entries="@array/prefdemo_ringtone_entries"
            android:entryValues="@array/prefdemo_ringtone_values"
            android:defaultValue="default" />

        <SwitchPreference
            android:key="vibrate_for_calls"
            android:title="Also vibrate for calls"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="charging_sounds"
            android:title="Charging sounds"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="touch_sounds"
            android:title="Touch sounds"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="screen_locking_sounds"
            android:title="Screen locking sounds"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
