<?xml version="1.0" encoding="utf-8"?>
<!-- Port of AOSP 12 Settings res/xml/location.xml fragments. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="location_settings_screen"
    android:title="Location">

    <SwitchPreference
        android:key="location_master"
        android:title="Use location"
        android:summaryOn="On"
        android:summaryOff="Off"
        android:defaultValue="true" />

    <ListPreference
        android:key="location_mode"
        android:title="Locating method"
        android:entries="@array/prefdemo_location_mode_entries"
        android:entryValues="@array/prefdemo_location_mode_values"
        android:dependency="location_master"
        android:defaultValue="high_battery" />

    <PreferenceCategory android:title="App access">

        <Preference android:key="location_app_maps" android:title="Maps" android:summary="Allowed all the time" android:dependency="location_master" />
        <Preference android:key="location_app_camera" android:title="Camera" android:summary="Allowed only while in use" android:dependency="location_master" />
        <Preference android:key="location_app_weather" android:title="Weather" android:summary="Ask every time" android:dependency="location_master" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Advanced">

        <SwitchPreference
            android:key="location_history"
            android:title="Location history"
            android:summary="Save your location with your account"
            android:dependency="location_master"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
