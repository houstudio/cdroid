<?xml version="1.0" encoding="utf-8"?>
<!-- Port of AOSP 12 Settings res/xml/notifications.xml fragments. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="notifications_screen"
    android:title="Notifications">

    <Preference
        android:key="notification_history"
        android:widgetLayout="@layout/prefdemo_chevron"
        android:title="Notification history"
        android:summary="Recent notifications" />

    <PreferenceCategory android:title="Lock screen">

        <ListPreference
            android:key="lock_screen_notifications"
            android:title="Notifications on lock screen"
            android:entries="@array/prefdemo_lockscreen_entries"
            android:entryValues="@array/prefdemo_lockscreen_values"
            android:defaultValue="all" />

        <SwitchPreference
            android:key="notifications_badging"
            android:title="Notification dots"
            android:summary="Allow notification dots"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Conversations">

        <SwitchPreference
            android:key="notifications_bubbles"
            android:title="Bubbles"
            android:summary="Show conversations as bubbles"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Channels (multi-select demo)">

        <MultiSelectListPreference
            android:key="notify_channels"
            android:title="Interruptive channels"
            android:summary="Which channels may interrupt"
            android:entries="@array/prefdemo_channel_entries"
            android:entryValues="@array/prefdemo_channel_values" />

    </PreferenceCategory>

</PreferenceScreen>
