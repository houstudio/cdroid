<?xml version="1.0" encoding="utf-8"?>
<!-- Port of AOSP 12 Settings res/xml/display_settings.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="display_settings_screen"
    android:title="Display">

    <PreferenceCategory android:title="Brightness">

        <Preference
            android:key="brightness"
            android:title="Brightness level"
            android:selectable="false" />

        <SwitchPreference
            android:key="auto_brightness_entry"
            android:title="Adaptive brightness"
            android:summary="Optimize brightness level for available light"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Lock display">

        <Preference android:widgetLayout="@layout/prefdemo_chevron" android:key="lockscreen_from_display_settings" android:title="Lock screen" />

        <ListPreference
            android:key="screen_timeout"
            android:title="Screen timeout"
            android:entries="@array/prefdemo_screen_timeout_entries"
            android:entryValues="@array/prefdemo_screen_timeout_values"
            android:defaultValue="60000" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Appearance">

        <SwitchPreference
            android:key="dark_ui_mode"
            android:title="Dark theme"
            android:summaryOn="On"
            android:summaryOff="Off"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="auto_rotate"
            android:title="Auto-rotate screen"
            android:defaultValue="true" />

        <ListPreference
            android:key="font_size"
            android:title="Font size"
            android:entries="@array/prefdemo_font_size_entries"
            android:entryValues="@array/prefdemo_font_size_values"
            android:defaultValue="1.0" />

        <Preference android:widgetLayout="@layout/prefdemo_chevron" android:key="wallpaper" android:title="Wallpaper &amp; style" />

    </PreferenceCategory>

</PreferenceScreen>
