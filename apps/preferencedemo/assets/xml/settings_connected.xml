<?xml version="1.0" encoding="utf-8"?>
<!-- Port of AOSP 12 Settings res/xml/connected_devices.xml. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="connected_devices_screen"
    android:title="Connected devices">

    <SwitchPreference
        android:key="bluetooth_enabled"
        android:title="Bluetooth"
        android:summaryOn="On"
        android:summaryOff="Off"
        android:defaultValue="false" />

    <Preference
        android:key="bluetooth_pairing"
        android:widgetLayout="@layout/prefdemo_chevron"
        android:title="Pair new device"
        android:dependency="bluetooth_enabled" />

    <Preference
        android:key="bluetooth_device_name"
        android:widgetLayout="@layout/prefdemo_chevron"
        android:title="Device name"
        android:summary="Android Phone"
        android:dependency="bluetooth_enabled" />

    <PreferenceCategory android:title="NFC">

        <SwitchPreference
            android:key="nfc_enabled"
            android:title="Use NFC"
            android:defaultValue="true" />

        <Preference
            android:key="nfc_payment"
        android:widgetLayout="@layout/prefdemo_chevron"
            android:title="Tap &amp; pay"
            android:dependency="nfc_enabled" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Media output">

        <Preference android:widgetLayout="@layout/prefdemo_chevron" android:key="cast_screen" android:title="Cast" />
        <Preference android:widgetLayout="@layout/prefdemo_chevron" android:key="printing" android:title="Printing" />

    </PreferenceCategory>

</PreferenceScreen>
