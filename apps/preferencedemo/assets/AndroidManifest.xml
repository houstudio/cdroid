<?xml version="1.0" encoding="utf-8"?>
<!-- Demo manifest: exercises App's manifest-driven resource orientation.
     android:screenOrientation is what CDROID's App::applyOrientationConfig
     reads (CDROID_ORIENTATION env overrides it, screen shape is the
     fallback). "portrait" here proves the chain: on a widescreen display the
     auto path would pick landscape, so a portrait layout means the manifest
     won. The MAIN/LAUNCHER filter only feeds getLauncherActivity(); the
     auto-launch runnable skips because main() already created the window. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cdroid.preferencedemo">

    <application android:label="Preference Demo">
        <activity android:name=".SettingsActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
