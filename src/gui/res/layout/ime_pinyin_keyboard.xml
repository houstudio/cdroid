<?xml version="1.0" encoding="utf-8"?>
<!--
  IME layout: the 1/2-level candidate strip on TOP, the soft keyboard
  (letter keys + function keys) full-width on the BOTTOM. The candidate strip
  and the close button share the top row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top row: candidate strip + close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CandidateView
            android:id="@+id/predict2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/closekeyboard"
            android:candidate_background="#112233"
            android:candidate_normal="#FFFFFF"
            android:layout_alignTop="@+id/closekeyboard"
            android:layout_alignBottom="@id/closekeyboard"
            android:background="@drawable/key_background_material"
            android:candidate_recommand="#FF0000"/>
        <ImageButton
            android:id="@+id/closekeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/key_background_material"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="#ffffff"
            android:contentDescription="Close"/>
    </RelativeLayout>

    <!-- Bottom: full-width keyboard (letters + function keys). wrap_content, not
         0dp+weight: the KeyboardView reports the installed keyboard's natural
         height and the IME window wraps the content (adaptive sizing); the weight
         pattern belonged to the old fixed-height window. No inline key* attrs:
         the look comes from the theme's keyboardViewStyle (Widget.KeyboardView
         and its Holo/Material variants), so App::setTheme reskins the keyboard
         and an overlay can still retune the style. -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
