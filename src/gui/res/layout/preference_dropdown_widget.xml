<?xml version="1.0" encoding="utf-8"?>
<!-- DropDownPreference widget frame: androidx preference_dropdown rides a
     full row layout; the CDROID port keeps the standard preference row and
     mounts the Spinner in the widget_frame slot instead. -->
<Spinner xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+android:id/spinner"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
