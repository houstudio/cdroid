<?xml version="1.0" encoding="utf-8"?>
<!-- NavigationView attributes (material NavigationView, widgetEx 0x02 shared-lib
     ids pinned in public.xml). Android:-namespaced attrs (maxWidth, background)
     resolve from the framework package and are read by their fw ids. -->
<resources>
    <declare-styleable name="NavigationView">
        <attr name="menu" format="reference" />
        <attr name="headerLayout" format="reference" />
        <attr name="itemIconSize" format="dimension" />
        <attr name="itemIconTint" format="color" />
        <attr name="itemTextAppearance" format="reference" />
        <attr name="itemTextColor" format="color" />
        <attr name="itemBackground" format="reference|color" />
        <attr name="itemHorizontalPadding" format="dimension" />
        <attr name="itemVerticalPadding" format="dimension" />
        <attr name="itemIconPadding" format="dimension" />
        <attr name="itemMaxLines" format="integer" />
    </declare-styleable>

    <!-- NavigationBarView (shared by BottomNavigationView); attrs reuse the
         NavigationView declarations above. -->
    <declare-styleable name="NavigationBarView">
        <attr name="itemIconTint" />
        <attr name="itemIconSize" />
        <attr name="itemTextColor" />
        <attr name="itemBackground" />
        <attr name="menu" />
    </declare-styleable>
    <declare-styleable name="BottomNavigationView">
        <attr name="itemHorizontalTranslationEnabled" format="boolean" />
    </declare-styleable>
</resources>
